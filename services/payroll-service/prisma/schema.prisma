generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum PayrollIdempotencyState {
  PROCESSING
  COMPLETED
  FAILED
}

enum PayrollJobStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
}

enum PayrollItemStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PayrollIdempotencyRecord {
  id              String                  @id @default(uuid()) @db.Uuid
  employerId      String                  @map("employer_id") @db.VarChar(100)
  key             String                  @map("idempotency_key") @db.VarChar(128)
  requestHash     String                  @map("request_hash") @db.Char(64)
  jobId           String                  @unique(map: "payroll_idempotency_records_job_id_key") @map("job_id") @db.Uuid
  state           PayrollIdempotencyState @default(PROCESSING)
  responseStatus  Int?                    @map("response_status") @db.SmallInt
  responseBody    Json?                   @map("response_body") @db.JsonB
  replayExpiresAt DateTime                @map("replay_expires_at") @db.Timestamptz(6)
  retentionUntil  DateTime                @map("retention_until") @db.Timestamptz(6)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  job             PayrollJob              @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([employerId, key], map: "payroll_idempotency_records_employer_key_key")
  @@index([state, updatedAt], map: "payroll_idempotency_records_state_updated_at_idx")
  @@index([retentionUntil], map: "payroll_idempotency_records_retention_until_idx")
  @@map("payroll_idempotency_records")
}

model PayrollJob {
  id                String                    @id @default(uuid()) @db.Uuid
  employerId        String                    @map("employer_id") @db.VarChar(100)
  sourceWalletId    String                    @map("source_wallet_id") @db.Uuid
  currency          String                    @db.Char(3)
  status            PayrollJobStatus          @default(PENDING)
  totalItems        Int                       @map("total_items")
  completedItems    Int                       @default(0) @map("completed_items")
  failedItems       Int                       @default(0) @map("failed_items")
  totalAmount       Decimal                   @map("total_amount") @db.Decimal(28, 8)
  bullmqJobId       String?                   @map("bullmq_job_id") @db.VarChar(160)
  queueFailureCount Int                       @default(0) @map("queue_failure_count")
  lastQueueErrorCode String?                  @map("last_queue_error_code") @db.VarChar(80)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt         DateTime?                 @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?                 @map("completed_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  idempotencyRecord PayrollIdempotencyRecord?
  items             PayrollItem[]

  @@index([employerId, createdAt(sort: Desc)], map: "payroll_jobs_employer_created_at_idx")
  @@index([status, updatedAt], map: "payroll_jobs_status_updated_at_idx")
  @@map("payroll_jobs")
}

model PayrollItem {
  id                       String            @id @default(uuid()) @db.Uuid
  payrollJobId             String            @map("payroll_job_id") @db.Uuid
  sequence                 Int
  externalItemId           String            @map("external_item_id") @db.VarChar(128)
  recipientWalletId        String            @map("recipient_wallet_id") @db.Uuid
  amount                   Decimal           @db.Decimal(28, 8)
  currency                 String            @db.Char(3)
  status                   PayrollItemStatus @default(PENDING)
  attemptCount             Int               @default(0) @map("attempt_count")
  processingToken          String?           @map("processing_token") @db.Uuid
  processingStartedAt      DateTime?         @map("processing_started_at") @db.Timestamptz(6)
  transferId               String?           @map("transfer_id") @db.Uuid
  transferIdempotencyKey   String            @unique(map: "payroll_items_transfer_idempotency_key_key") @map("transfer_idempotency_key") @db.VarChar(128)
  failureCode              String?           @map("failure_code") @db.VarChar(80)
  completedAt              DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  payrollJob               PayrollJob        @relation(fields: [payrollJobId], references: [id], onDelete: Restrict)

  @@unique([payrollJobId, externalItemId], map: "payroll_items_job_external_item_key")
  @@unique([payrollJobId, sequence], map: "payroll_items_job_sequence_key")
  @@index([payrollJobId, status, sequence], map: "payroll_items_job_status_sequence_idx")
  @@index([status, processingStartedAt], map: "payroll_items_status_processing_started_at_idx")
  @@map("payroll_items")
}
