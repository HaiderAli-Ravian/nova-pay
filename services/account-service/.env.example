NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/account_db
LEDGER_BASE_URL=http://localhost:3003
ADMIN_BASE_URL=http://localhost:3006
INTERNAL_SERVICE_TOKEN=replace-with-a-local-internal-token
IDENTITY_ACTIVE_KEY_VERSION=v1
IDENTITY_KEK_RING={"v1":"replace-with-canonical-base64-for-32-random-bytes"}
IDENTITY_LOOKUP_HMAC_KEY=replace-with-canonical-base64-for-32-random-bytes
